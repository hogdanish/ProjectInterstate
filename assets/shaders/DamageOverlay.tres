code = "shader_type canvas_item;
render_mode unshaded;

uniform sampler2D tex_frg_13;



void fragment() {
// Input:21
	vec4 n_out21p0 = COLOR;


// Input:12
	vec2 n_out12p0 = UV;


// UVFunc:15
	vec2 n_in15p1 = vec2(0.90000, 0.50000);
	vec2 n_in15p2 = vec2(0.50000, 0.50000);
	vec2 n_out15p0 = fma((n_out12p0 - n_in15p2), n_in15p1, n_in15p2);


// Texture2D:13
	vec4 n_out13p0 = texture(tex_frg_13, n_out15p0);


// VectorDecompose:22
	float n_out22p0 = n_out21p0.x;
	float n_out22p1 = n_out21p0.y;
	float n_out22p2 = n_out21p0.z;
	float n_out22p3 = n_out21p0.w;


	float n_out31p0;
// Remap:31
	float n_in31p1 = 0.00000;
	float n_in31p2 = 1.00000;
	float n_in31p3 = 0.00000;
	float n_in31p4 = 1.03000;
	{
		float __input_range = n_in31p2 - n_in31p1;
		float __output_range = n_in31p4 - n_in31p3;
		n_out31p0 = n_in31p3 + __output_range * ((n_out22p3 - n_in31p1) / __input_range);
	}


// FloatOp:32
	float n_in32p1 = 0.10000;
	float n_out32p0 = pow(n_out31p0, n_in32p1);


	float n_out16p0;
// Remap:16
	float n_in16p1 = 0.00000;
	float n_in16p2 = 1.00000;
	float n_in16p3 = 24.00000;
	float n_in16p4 = 1.75000;
	{
		float __input_range = n_in16p2 - n_in16p1;
		float __output_range = n_in16p4 - n_in16p3;
		n_out16p0 = n_in16p3 + __output_range * ((n_out32p0 - n_in16p1) / __input_range);
	}


// FloatOp:14
	float n_out14p0 = pow(n_out13p0.x, n_out16p0);


// FloatOp:27
	float n_in27p1 = 1.25000;
	float n_out27p0 = n_out14p0 * n_in27p1;


// Compare:25
	float n_in25p1 = 0.00200;
	bool n_out25p0 = n_out14p0 > n_in25p1;


// FloatOp:26
	float n_out26p0 = n_out27p0 * (n_out25p0 ? 1.0 : 0.0);


// SmoothStep:29
	float n_in29p0 = 0.00000;
	float n_in29p1 = 1.50000;
	float n_out29p0 = smoothstep(n_in29p0, n_in29p1, n_out26p0);


// FloatOp:28
	float n_in28p1 = 0.75000;
	float n_out28p0 = n_out29p0 * n_in28p1;


// Output:0
	COLOR.rgb = vec3(n_out21p0.xyz);
	COLOR.a = n_out28p0;


}
