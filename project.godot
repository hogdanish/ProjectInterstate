[panku]

toggle_console_action="toggle_console"
pause_when_active=true

[physics]

3d/run_on_separate_thread=true
common/physics_ticks_per_second=120

[rendering]

textures/lossless_compression/force_png=true
environment/ssao/quality=3
environment/ssao/half_size=false
environment/ssil/quality=3
environment/ssil/half_size=false
anti_aliasing/screen_space_roughness_limiter/limit=0.01
scaling_3d/mode=1
scaling_3d/fsr_sharpness=0.0
environment/screen_space_reflection/roughness_quality=3
environment/subsurface_scattering/subsurface_scattering_quality=3
global_illumination/sdfgi/frames_to_converge=2
environment/volumetric_fog/volume_size=256
environment/volumetric_fog/volume_depth=256
2d/snap/snap_2d_transforms_to_pixel=true
textures/canvas_textures/default_texture_filter=0
