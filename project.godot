; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

_global_script_classes=[{
"base": "CanvasLayer",
"class": &"Console",
"language": &"GDScript",
"path": "res://Menu/Console/Console.gd"
}, {
"base": "RefCounted",
"class": &"ConsoleConfig",
"language": &"GDScript",
"path": "res://Menu/Console/components/config.gd"
}, {
"base": "RefCounted",
"class": &"ConsoleUtils",
"language": &"GDScript",
"path": "res://Menu/Console/components/utils.gd"
}, {
"base": "RefCounted",
"class": &"Damage",
"language": &"GDScript",
"path": "res://Weapons/Damage/Damage.gd"
}, {
"base": "Damage",
"class": &"DamageFall",
"language": &"GDScript",
"path": "res://Weapons/Damage/DamageFall.gd"
}, {
"base": "Damage",
"class": &"DamagePunch",
"language": &"GDScript",
"path": "res://Weapons/Damage/DamagePunch.gd"
}, {
"base": "Node3D",
"class": &"GameState",
"language": &"GDScript",
"path": "res://Game/GameState.gd"
}, {
"base": "SubViewportContainer",
"class": &"GameStateContainer",
"language": &"GDScript",
"path": "res://Game/GameStateContainer.gd"
}, {
"base": "Node",
"class": &"Main",
"language": &"GDScript",
"path": "res://Main.gd"
}, {
"base": "PlayerMovement",
"class": &"Player",
"language": &"GDScript",
"path": "res://Characters/Player/Player.gd"
}, {
"base": "Camera3D",
"class": &"PlayerCamera",
"language": &"GDScript",
"path": "res://Characters/Player/PlayerCamera.gd"
}, {
"base": "RefCounted",
"class": &"PlayerHudUpdate",
"language": &"GDScript",
"path": "res://Characters/Player/PlayerHudUpdate.gd"
}, {
"base": "PlayerShared",
"class": &"PlayerInput",
"language": &"GDScript",
"path": "res://Characters/Player/PlayerInput.gd"
}, {
"base": "PlayerInput",
"class": &"PlayerMovement",
"language": &"GDScript",
"path": "res://Characters/Player/PlayerMovement.gd"
}, {
"base": "CharacterBody3D",
"class": &"PlayerShared",
"language": &"GDScript",
"path": "res://Characters/Player/PlayerShared.gd"
}, {
"base": "Node3D",
"class": &"Weapon",
"language": &"GDScript",
"path": "res://Weapons/WeaponTypes/Generic/Weapon.gd"
}]
_global_script_class_icons={
"Console": "",
"ConsoleConfig": "",
"ConsoleUtils": "",
"Damage": "",
"DamageFall": "",
"DamagePunch": "",
"GameState": "",
"GameStateContainer": "",
"Main": "",
"Player": "",
"PlayerCamera": "",
"PlayerHudUpdate": "",
"PlayerInput": "",
"PlayerMovement": "",
"PlayerShared": "",
"Weapon": ""
}

[application]

config/name="ShartyShooter"
run/main_scene="res://HUD/BootScreen/BootScreen.tscn"
config/features=PackedStringArray("4.0", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Globals="*res://Services/Globals.gd"
AppState="res://Services/AppState.gd"
Settings="*res://Services/Settings.gd"
Events="*res://Services/Events.gd"
ConsoleLogger="*res://Services/ConsoleLogger.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray()

[filesystem]

import/blender/enabled=false
import/fbx/enabled=false

[gui]

theme/default_font_antialiasing=0
theme/default_font_multichannel_signed_distance_field=true

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/channel_pack": 0,
"compress/hdr_compression": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false,
"mipmaps/limit": -1,
"process/fix_alpha_border": false,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 0,
"roughness/mode": 1,
"roughness/src_normal": ""
}

