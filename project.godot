_global_script_class_icons={
"Damage": "",
"DamageFall": "",
"DamagePunch": "",
"Game": "",
"Main": "",
"Player": "",
"PlayerCamera": "",
"PlayerHudUpdate": "",
"PlayerInput": "",
"PlayerMovement": "",
"PlayerShared": "",
"State": "res://addons/xsm/icons/state.png",
"StateAnimation": "res://addons/xsm/icons/state_animation.png",
"StateLoop": "res://addons/xsm/icons/state_loop.png",
"StateRand": "res://addons/xsm/icons/state_rand.png",
"StateRegions": "res://addons/xsm/icons/state_regions.png",
"Weapon": ""
}

[application]

config/name="ProjectInterstate"
run/main_scene="res://boot.tscn"
config/features=PackedStringArray("4.0", "Forward Plus")
run/max_fps=119
config/icon="res://icon.svg"

[autoload]

Globals="*res://src/Globals.gd"
Settings="*res://src/Settings.gd"
Events="*res://src/Events.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/resizable=false
window/vsync/vsync_mode=0
window/stretch/mode="canvas_items"

[editor]

script/templates_search_path="res://addons/xsm/templates/"
movie_writer/fps=119

[editor_plugins]

enabled=PackedStringArray("res://addons/xsm/plugin.cfg")

[filesystem]

import/blender/enabled=false
import/fbx/enabled=false

[gui]

theme/default_font_antialiasing=0
theme/default_font_multichannel_signed_distance_field=true

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/channel_pack": 0,
"compress/hdr_compression": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false,
"mipmaps/limit": -1,
"process/fix_alpha_border": false,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 0,
"roughness/mode": 1,
"roughness/src_normal": ""
}

